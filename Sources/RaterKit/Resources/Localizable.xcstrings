    "rater.error.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server sent something we couldn't read."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器返回了无法识别的内容"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーから読み取れない応答が返されました。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat eine unlesbare Antwort gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor envió una respuesta que no pudimos leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a envoyé une réponse illisible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha inviato una risposta illeggibile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에서 읽을 수 없는 응답이 왔어요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor enviou uma resposta ilegível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер вернул неразборчивый ответ."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器傳回了無法識別的內容"
          }
        }
      }
    },
    "rater.error.server": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server had a problem. Please try again later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器出了点问题，请稍后再试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーで問題が発生しました。しばらくしてからお試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server ist ein Problem aufgetreten. Bitte später erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tuvo un problema. Inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a rencontré un problème. Merci de réessayer plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si è verificato un problema sul server. Riprova più tardi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 문제가 생겼어요. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocorreu um problema no servidor. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сервере возникла проблема. Повторите попытку позже."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器出了點問題，請稍後再試"
          }
        }
      }
    },
    "rater.error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network connection. Check your connection and try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络连接不可用，请检查后重试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークに接続できません。接続を確認してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Netzwerkverbindung. Bitte Verbindung prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión a internet. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune connexion réseau. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione di rete. Controlla la connessione e riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에 연결되어 있지 않아요. 연결을 확인한 뒤 다시 시도해 주세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem ligação à rede. Verifique a ligação e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения к сети. Проверьте соединение и повторите попытку."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路連線不可用，請檢查後重試"
          }
        }
      }
    },
    "rater.error.attachment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That screenshot couldn't be processed. Try another one."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "截图处理失败，请换一张试试"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリーンショットを処理できませんでした。別の画像でお試しください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Screenshot konnte nicht verarbeitet werden. Bitte einen anderen wählen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo procesar la captura. Prueba con otra."
          }
        },
        "fr": {
          "stringUnit": {
