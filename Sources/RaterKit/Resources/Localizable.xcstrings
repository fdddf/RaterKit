{
  "sourceLanguage": "en",
  "strings": {
    "rater.prompt.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help us improve"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我们做得更好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "改善にご協力ください"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf uns, besser zu werden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayúdanos a mejorar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aidez-nous à nous améliorer"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiutaci a migliorare"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 나은 앱이 되도록 도와주세요"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude-nos a melhorar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите нам стать лучше"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫我們做得更好"
          }
        }
      }
    },
    "rater.prompt.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your opinion matters to us — it only takes a few seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的看法对我们很重要，花几秒告诉我们吧。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご意見をぜひ聞かせてください。数秒で終わります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Meinung ist uns wichtig – es dauert nur ein paar Sekunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu opinión nos importa: solo te llevará unos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre avis compte pour nous — cela ne prend que quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua opinione è importante per noi: ci vogliono solo pochi secondi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 의견은 큰 도움이 됩니다. 몇 초면 끝나요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua opinião é importante para nós — só leva alguns segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше мнение важно для нас — это займёт всего несколько секунд."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的看法對我們很重要，花幾秒告訴我們吧。"
          }
        }
      }
    },
