    "rater.form.diagnosticsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This helps us reproduce the problem. It contains nothing that identifies you."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
