          "stringUnit": {
            "state": "translated",
            "value": "보내주신 의견은 모두 읽어봅니다. 이메일을 남겨 주셨다면 답장을 드릴게요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lemos todas as mensagens. Se deixou o seu e-mail, entraremos em contacto."
          }
