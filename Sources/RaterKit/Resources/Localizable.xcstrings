{
  "sourceLanguage": "en",
  "strings": {
    "rater.prompt.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoying this app?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢这个 App 吗？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリはいかがですか？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefällt dir diese App?"
          }
        }
      }
    },
    "rater.prompt.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your opinion matters to us — it only takes a few seconds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的看法对我们很重要，花几秒告诉我们吧。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご意見をぜひ聞かせてください。数秒で終わります。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Meinung ist uns wichtig – es dauert nur ein paar Sekunden."
          }
        }
      }
    },
    "rater.prompt.positive": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I like it"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喜欢"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気に入っています"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefällt mir"
          }
        }
      }
    },
    "rater.prompt.negative": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not quite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还不够好"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いまひとつ"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht ganz"
          }
        }
      }
    },
    "rater.prompt.later": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maybe later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以后再说"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vielleicht später"
          }
        }
      }
    },
    "rater.prompt.optOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't ask again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再提示"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後は表示しない"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht mehr fragen"
          }
        }
      }
    },
