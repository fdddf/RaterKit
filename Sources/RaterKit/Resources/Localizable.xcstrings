    "rater.form.emailHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only used to reply to you. Leave it blank to stay anonymous."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于回复你。留空则匿名提交。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご返信のみに使用します。空欄のままでも送信できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für unsere Antwort. Leer lassen, um anonym zu bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se usa para responderte. Déjalo vacío para enviarlo de forma anónima."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé uniquement pour vous répondre. Laissez vide pour rester anonyme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata solo per risponderti. Lascia vuoto per restare anonimo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답장을 보낼 때만 사용해요. 비워 두면 익명으로 전송됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado apenas para lhe responder. Deixe em branco para ficar anónimo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется только для ответа вам. Оставьте пустым, чтобы отправить анонимно."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅用於回覆你。留空則匿名提交。"
          }
        }
      }
